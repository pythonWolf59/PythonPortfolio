{
    "editor.tokenColorCustomizations": {
    "textMateRules": [
        {
            "scope": [
                "comment",
                "string.quoted.docstring"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#08a757" // Optional: customize the color
            }
        },
        {
            "scope": "string.quoted",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#d6f7ab" // Light green color
            }
        },
        {
            "scope": "constant.numeric.integer",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#FFA500" // Orange color
            }
        },
        {
            "scope": [
                "constant.numeric.float",
                "constant.numeric.double"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#FFFFFF" // White color
            }
        },
        {
            "scope": "constant.language.boolean",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#0000FF" // Blue color
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "fontStyle": "bold",
                "foreground": "#0ac3c3" // Ocean color
            }
        }
    ]
}

}